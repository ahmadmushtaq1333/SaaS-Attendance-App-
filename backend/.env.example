# Backend environment variables template
# Copy this file to .env and fill in your values
# NEVER commit .env — it is in .gitignore

# ── Django core ───────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=attendance_saas.settings.dev
SECRET_KEY=dev-secret-key-please-change
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (dev uses SQLite, prod uses MySQL via Railway) ───────────────────
DATABASE_URL=sqlite:///db.sqlite3

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-jwt-secret
JWT_ALGORITHM=HS256

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Production-only: Railway & Vercel domains (leave blank for dev) ───────────
RAILWAY_PUBLIC_DOMAIN=
VERCEL_DOMAIN=

# ── Production-only: CSRF trusted origins (comma-separated) ──────────────────
CSRF_TRUSTED_ORIGINS=

# ── Production-only: MySQL (set by Railway plugin automatically) ──────────────
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLHOST=
MYSQLPORT=3306

# ── Email — Brevo HTTP API ────────────────────────────────────────────────────
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Quorum <your@email.com>

# ── Sentry error tracking ─────────────────────────────────────────────────────
SENTRY_DSN=
