# Environment variables template — project root
# See backend/.env.example for the full backend reference
# NEVER commit real secrets

SECRET_KEY=dev-secret-key-please-change
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=attendance_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_HOST=db
DB_PORT=3306

# ── Domains (production only) ─────────────────────────────────────────────────
RAILWAY_PUBLIC_DOMAIN=
VERCEL_DOMAIN=
CSRF_TRUSTED_ORIGINS=

# ── Email ─────────────────────────────────────────────────────────────────────
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Quorum <your@email.com>

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
